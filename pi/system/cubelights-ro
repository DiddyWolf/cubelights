#!/usr/bin/env bash
set -euo pipefail

# Re-enables OverlayFS read-only root protection after maintenance.
if [[ "${EUID}" -ne 0 ]]; then
  echo "Please run as root: sudo $0" >&2
  exit 1
fi

sync
raspi-config nonint do_overlayfs 0
echo "OverlayFS re-enabled. Reboot now to return to protected read-only mode:"
echo "  sudo reboot"
